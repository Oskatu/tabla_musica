{
  "name": "tabla-musica",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Estudio de música en el navegador: crea canciones, simula pistas de instrumentos, mezcla, ve la partitura y transcribe tarareos.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test": "esbuild tests/run.ts --bundle --platform=node --format=esm --outfile=.tmp-test/tests.mjs --external:jsdom --loader:.tsx=tsx --log-level=error && node .tmp-test/tests.mjs",
    "test:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vexflow": "^4.2.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
